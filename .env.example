# SocialKoneqti Agent — pre-filled per user by the dashboard download.
# Place a copy named `.env` next to the installed .exe or in the app's userData folder
# (%APPDATA%\SocialKoneqti Agent\.env). It seeds local settings on first run only.
# NEVER commit a real .env — this repository is public.
BRAIN_URL=https://social.koneqti.com/api/gateway
API_KEY=sk_live_replace_me
USER_ID=
POLL_INTERVAL_MS=10000
HEARTBEAT_INTERVAL_MS=60000
ADSPOWER_URL=http://localhost:50325
# Optional: only if AdsPower "Local API security" is enabled
ADSPOWER_API_KEY=
