{
  "name": "socialkoneqti-agent",
  "version": "0.1.0",
  "description": "SocialKoneqti Agent — thin executor: polls the brain, runs playbooks in AdsPower profiles, reports results. Zero intelligence.",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/build-main.mjs && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --config electron-builder.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Korakora123/socialkoneqtilauncher.git"
  },
  "author": "Koneqti <noreply@koneqti.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Korakora123/socialkoneqtilauncher/issues"
  },
  "homepage": "https://github.com/Korakora123/socialkoneqtilauncher#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "cloakbrowser": "^0.5.11",
    "dotenv": "^16.6.1",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "productName": "SocialKoneqti Agent",
  "private": true
}
